# Copy to .env (docker compose reads it automatically). Never commit .env.

# LLM provider key(s)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Your own vtk-mcp server (HTTP transport), used with docker-compose.external-mcp.yml.
# Users see it in their settings, read-only.
VTK_PROMPT_MCP_URL=

# Google sign-in, used with docker-compose.auth.yml
# From console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (type Web application, redirect URI <public url>/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
VTK_PROMPT_SECRET_KEY=
# Public URL when behind a proxy or TLS, for example https://prompt.example.com
VTK_PROMPT_BASE_URL=
